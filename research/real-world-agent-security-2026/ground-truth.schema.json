{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/psandhir/horustrace/research/real-world-agent-security-2026/ground-truth.schema.json",
  "title": "HorusTrace Real-World Agent Security 2026 ground truth",
  "type": "object",
  "required": [
    "schema_version",
    "study",
    "case_id",
    "truth_lock",
    "tier_a",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study": {
      "const": "real-world-agent-security-2026"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "truth_lock": {
      "type": "object",
      "required": [
        "reviewed",
        "horustrace_output_seen",
        "locked_at",
        "reviewers"
      ],
      "properties": {
        "reviewed": {
          "const": true
        },
        "horustrace_output_seen": {
          "const": false
        },
        "locked_at": {
          "type": "string"
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "tier_a": {
      "type": "object",
      "required": [
        "frameworks",
        "agent_roots",
        "tools",
        "mcp_servers",
        "delegation_edges",
        "unresolved"
      ],
      "properties": {
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent_roots": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "delegation_edges": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertion_id",
          "subject",
          "predicate",
          "expected_state",
          "evidence",
          "rationale"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "object": {},
          "expected_state": {
            "enum": [
              "present",
              "absent",
              "unresolved"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "rationale"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "tier_b": {
      "type": [
        "object",
        "null"
      ]
    },
    "tier_c": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
